CODE_SERVER_PASSWORD=change-this-password
CLINE_VERSION=4.1.3
OLLAMA_MODEL=qwen3-coder:30b
# Ordered comma-separated fallback list for GPU/Vast workers.
OLLAMA_MODELS=qwen3-coder:30b,qwen2.5-coder:14b
MODEL_ATTEMPT_TIMEOUT_MS=60000
TZ=Asia/Jakarta
BASE_DOMAIN=example.com
APP_DOMAIN=code.example.com
ACME_EMAIL=admin@example.com
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
WEBUI_SECRET_KEY=replace-with-a-persistent-32-byte-secret
RATE_LIMIT_USER_PER_MINUTE=240
RATE_LIMIT_WORKER_PER_MINUTE=1200
RATE_LIMIT_BILLING_PER_MINUTE=120
DB_POOL_SIZE=20
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
CODE_SERVER_IMAGE=codercom/code-server:4.133.0@sha256:e073a441c61c85821a7f16b64cf93b4e77b4092899bb1f3bed906fbd558afd62
OLLAMA_IMAGE=ollama/ollama:0.32.14
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0

# Optional isolated worker profile.
SANDBOX_WORKER_TOKEN=replace-with-a-worker-token-for-one-tenant
SANDBOX_WORKSPACE_ROOT=/absolute/path/to/one-tenant-workspaces
SANDBOX_PAYLOAD_UID=1000
SANDBOX_PAYLOAD_GID=1000
WORKER_LEASE_MS=90000
