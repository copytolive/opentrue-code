#!/usr/bin/env python3
from __future__ import annotations
from pathlib import Path
import json,sys,time
sys.path.insert(0,str(Path(__file__).resolve().parent/"lib"))
from tapeout_adapter_lib import (
    MANIFEST,CONTRACTS,CPUS,SEL,require_chain,uint_call,words_call,address_call,
    public_bnb_usd,parse_netlist,task_meta,eth_call_batch,calldata,decode_words
)

def chain_snapshot(p):
    tid=int(p["task_id"]); cost_f=float(p["design_cost"])
    if not cost_f.is_integer() or cost_f<=0: raise RuntimeError("design_cost must be a positive integer C")
    cost=int(cost_f); net=str(p.get("netlist_hex") or "")
    counts=parse_netlist(net)
    task=task_meta(tid)
    if not task.get("full_domain_stateless"):
        raise RuntimeError("task is outside audited full-domain combinational live scope")
    cid,block,gas=require_chain()
    mining=CONTRACTS["mining"]; lens=CONTRACTS["lens"]
    tv=uint_call(mining,SEL["totalVerifWeight"])
    tu=uint_call(mining,SEL["totalUnverWeight"])
    emission_raw=uint_call(mining,SEL["dailyEmission"])
    ubps=uint_call(mining,SEL["UNVERIFIED_BPS"])
    if ubps<0 or ubps>10000: raise RuntimeError("invalid UNVERIFIED_BPS")
    bnb_usd,bnb_source=public_bnb_usd()
    processors=[]
    multiplier_drift=[]
    inactive_processors=[]
    for name,pin in CPUS.items():
        addr=pin["address"]
        pinned_mult=int(pin["multiplier"])
        mult=int(uint_call(mining,SEL["processorMultiplier"],["address"],[addr]))
        if mult < 0 or mult > 0xFFFFFFFF:
            raise RuntimeError(f"invalid processor multiplier for {name}: {mult}")
        if mult == 0:
            inactive_processors.append({"name":name,"address":addr,"pinned_multiplier":pinned_mult,"live_multiplier":0,"reason":"processorMultiplier(address)=0"})
            continue
        if mult != pinned_mult:
            multiplier_drift.append({"name":name,"address":addr,"pinned_multiplier":pinned_mult,"live_multiplier":mult})
        best=words_call(lens,SEL["bestSlot"],["uint32","address"],[tid,addr])
        if len(best)<2: raise RuntimeError(f"bestSlot malformed for {name}")
        holder_plus1=int(best[0]); incumbent=int(best[1]) if holder_plus1 else None
        wins=incumbent is None or cost<int(incumbent)
        bonus=uint_call(lens,SEL["bonusOf"],["uint32","uint256"],[tid,cost]) if wins else 0
        weight=(counts["bstar"]+int(bonus))*int(mult)
        if weight<=0: raise RuntimeError(f"non-positive preview weight for {name}")
        trans=address_call(addr,SEL["transistors"])
        mint_price=uint_call(trans,SEL["mintPrice"])
        protocol_fee=uint_call(trans,SEL["protocolFee"])
        cap=uint_call(trans,SEL["supplyCap"])
        minted=uint_call(trans,SEL["minted"])
        nand_id=uint_call(trans,SEL["NAND"]); latch_id=uint_call(trans,SEL["LATCH"])
        if nand_id!=0 or latch_id!=1: raise RuntimeError(f"unexpected transistor token IDs for {name}")
        need=counts["nand"]+counts["latch"]; enough_primary=(minted+need)<=cap
        nand_price=None; latch_price=None
        if enough_primary:
            nand_price=(mint_price+protocol_fee/counts["nand"])/1e18 if counts["nand"] else mint_price/1e18
            latch_price=(mint_price+protocol_fee/counts["latch"])/1e18 if counts["latch"] else mint_price/1e18
        processors.append({
            "name":name,"address":addr,"multiplier":float(mult),"pinned_multiplier":pinned_mult,"multiplier_changed":bool(mult!=pinned_mult),
            "incumbent_c":None if incumbent is None else float(incumbent),"incumbent_owner":None,"preview_eligible":True,"preview_weight":float(weight),
            "preview_reason":("AUDITED_PRE_TAPEOUT_FORMULA: H=(NAND+LATCH+bonus_if_strictly_optimal)*P; "f"slot={'EMPTY' if incumbent is None else 'TAKEN'}; candidate_strictly_optimal={wins}; bonus={bonus}; primary_transistor_inventory={'OK' if enough_primary else 'SOLD_OUT'}"),
            "nand_price_bnb":None if nand_price is None else float(nand_price),"latch_price_bnb":None if latch_price is None else float(latch_price),
        })
    if not processors: raise RuntimeError("no audited processor currently participates in mining")
    return {"chain_id":cid,"block_number":block,"total_verified_weight":float(tv),"total_unverified_weight":float(tu),"daily_emission_bem":float(emission_raw)/1e8,
        "verified_pool_share":float(10000-ubps)/10000.0,"unverified_pool_share":float(ubps)/10000.0,"bnb_usd":float(bnb_usd),"gas_price_wei":gas,
        "processors":processors,"inactive_processors":inactive_processors,"processor_multiplier_drift":multiplier_drift,"fetched_at":time.time(),
        "source":f"official TapeOut v8.1 deployment discovery pins + live BNB mining state + {bnb_source}","verified_source":True}

def _common_context():
    cid,block,gas=require_chain(); mining=CONTRACTS["mining"]
    tv=uint_call(mining,SEL["totalVerifWeight"]); tu=uint_call(mining,SEL["totalUnverWeight"]); emission_raw=uint_call(mining,SEL["dailyEmission"]); ubps=uint_call(mining,SEL["UNVERIFIED_BPS"])
    if ubps<0 or ubps>10000: raise RuntimeError("invalid UNVERIFIED_BPS")
    bnb_usd,bnb_source=public_bnb_usd(); active=[]; drift=[]; inactive=[]
    for name,pin in CPUS.items():
        addr=pin["address"]; pinned_mult=int(pin["multiplier"]); mult=int(uint_call(mining,SEL["processorMultiplier"],["address"],[addr]))
        if mult < 0 or mult > 0xFFFFFFFF: raise RuntimeError(f"invalid processor multiplier for {name}: {mult}")
        if mult==0:
            inactive.append({"name":name,"address":addr,"pinned_multiplier":pinned_mult,"live_multiplier":0,"reason":"processorMultiplier(address)=0"}); continue
        if mult!=pinned_mult: drift.append({"name":name,"address":addr,"pinned_multiplier":pinned_mult,"live_multiplier":mult})
        trans=address_call(addr,SEL["transistors"]); mint_price=uint_call(trans,SEL["mintPrice"]); protocol_fee=uint_call(trans,SEL["protocolFee"]); cap=uint_call(trans,SEL["supplyCap"]); minted=uint_call(trans,SEL["minted"])
        nand_id=uint_call(trans,SEL["NAND"]); latch_id=uint_call(trans,SEL["LATCH"])
        if nand_id!=0 or latch_id!=1: raise RuntimeError(f"unexpected transistor token IDs for {name}")
        active.append({"name":name,"address":addr,"pinned_multiplier":pinned_mult,"multiplier":mult,"transistors":trans,"mint_price":mint_price,"protocol_fee":protocol_fee,"supply_cap":cap,"minted":minted})
    if not active: raise RuntimeError("no audited processor currently participates in mining")
    return {"chain_id":cid,"block_number":block,"gas_price_wei":gas,"total_verified_weight":float(tv),"total_unverified_weight":float(tu),"daily_emission_bem":float(emission_raw)/1e8,
        "verified_pool_share":float(10000-ubps)/10000.0,"unverified_pool_share":float(ubps)/10000.0,"bnb_usd":float(bnb_usd),"bnb_source":bnb_source,"active":active,"inactive":inactive,"drift":drift}

def chain_snapshots(payload):
    reqs=list((payload or {}).get("requests") or [])
    if not reqs: return []
    if len(reqs)>500: raise RuntimeError("too many batch snapshot requests")
    prepared=[]
    for pos,p in enumerate(reqs):
        tid=int(p["task_id"]); cost_f=float(p["design_cost"])
        if not cost_f.is_integer() or cost_f<=0: raise RuntimeError("design_cost must be a positive integer C")
        net=str(p.get("netlist_hex") or ""); counts=parse_netlist(net); task=task_meta(tid)
        if not task.get("full_domain_stateless"): raise RuntimeError("task is outside audited full-domain combinational live scope")
        prepared.append({"pos":pos,"task_id":tid,"cost":int(cost_f),"counts":counts})
    common=_common_context(); lens=CONTRACTS["lens"]
    best_calls=[]; best_meta=[]
    for r in prepared:
        for cpu in common["active"]:
            best_calls.append((lens,calldata(SEL["bestSlot"],["uint32","address"],[r["task_id"],cpu["address"]]))); best_meta.append((r,cpu))
    best_raw=eth_call_batch(best_calls,timeout=18,batch_size=8); best_values={}; bonus_calls=[]; bonus_meta=[]
    for raw,(r,cpu) in zip(best_raw,best_meta):
        words=[int(x) for x in decode_words(raw)]
        if len(words)<2: raise RuntimeError(f"bestSlot malformed for {cpu['name']}")
        holder_plus1=int(words[0]); incumbent=int(words[1]) if holder_plus1 else None; wins=incumbent is None or r["cost"]<incumbent; key=(r["pos"],cpu["name"])
        best_values[key]={"incumbent":incumbent,"wins":wins,"bonus":0}
        if wins:
            bonus_calls.append((lens,calldata(SEL["bonusOf"],["uint32","uint256"],[r["task_id"],r["cost"]]))); bonus_meta.append(key)
    if bonus_calls:
        bonus_raw=eth_call_batch(bonus_calls,timeout=18,batch_size=8)
        for raw,key in zip(bonus_raw,bonus_meta):
            words=[int(x) for x in decode_words(raw)]
            if not words: raise RuntimeError("bonusOf returned no word")
            best_values[key]["bonus"]=int(words[0])
    snapshots=[]
    for r in prepared:
        processors=[]
        for cpu in common["active"]:
            state=best_values[(r["pos"],cpu["name"])]; bonus=int(state["bonus"]); mult=int(cpu["multiplier"]); weight=(r["counts"]["bstar"]+bonus)*mult
            if weight<=0: raise RuntimeError(f"non-positive preview weight for {cpu['name']}")
            need=r["counts"]["nand"]+r["counts"]["latch"]; enough=(int(cpu["minted"])+need)<=int(cpu["supply_cap"]); nand_price=None; latch_price=None
            if enough:
                mp=int(cpu["mint_price"]); fee=int(cpu["protocol_fee"]); nand_price=(mp+(fee/r["counts"]["nand"] if r["counts"]["nand"] else 0))/1e18; latch_price=(mp+(fee/r["counts"]["latch"] if r["counts"]["latch"] else 0))/1e18
            processors.append({"name":cpu["name"],"address":cpu["address"],"multiplier":float(mult),"pinned_multiplier":cpu["pinned_multiplier"],"multiplier_changed":bool(mult!=int(cpu["pinned_multiplier"])),
                "incumbent_c":None if state["incumbent"] is None else float(state["incumbent"]),"incumbent_owner":None,"preview_eligible":True,"preview_weight":float(weight),
                "preview_reason":("AUDITED_PRE_TAPEOUT_FORMULA+ADAPTIVE_RPC: H=(NAND+LATCH+bonus_if_strictly_optimal)*P; "f"slot={'EMPTY' if state['incumbent'] is None else 'TAKEN'}; candidate_strictly_optimal={state['wins']}; bonus={bonus}; primary_transistor_inventory={'OK' if enough else 'SOLD_OUT'}"),
                "nand_price_bnb":None if nand_price is None else float(nand_price),"latch_price_bnb":None if latch_price is None else float(latch_price)})
        snapshots.append({"chain_id":common["chain_id"],"block_number":common["block_number"],"total_verified_weight":common["total_verified_weight"],"total_unverified_weight":common["total_unverified_weight"],
            "daily_emission_bem":common["daily_emission_bem"],"verified_pool_share":common["verified_pool_share"],"unverified_pool_share":common["unverified_pool_share"],"bnb_usd":common["bnb_usd"],"gas_price_wei":common["gas_price_wei"],
            "processors":processors,"inactive_processors":common["inactive"],"processor_multiplier_drift":common["drift"],"fetched_at":time.time(),
            "source":"official TapeOut v8.1 deployment discovery pins + live BNB mining state + "+str(common["bnb_source"])+" + adaptive provider-compatible RPC scan","verified_source":True})
    return snapshots

def probe():
    cid,block,gas=require_chain(); bnb_usd,bnb_source=public_bnb_usd(); mining=CONTRACTS["mining"]; ubps=uint_call(mining,SEL["UNVERIFIED_BPS"])
    if ubps<0 or ubps>10000: raise RuntimeError("invalid UNVERIFIED_BPS")
    rows=[]; active=0; drift=[]
    for name,pin in CPUS.items():
        addr=pin["address"]; pinned_mult=int(pin["multiplier"]); mult=int(uint_call(mining,SEL["processorMultiplier"],["address"],[addr]))
        if mult < 0 or mult > 0xFFFFFFFF: raise RuntimeError(f"invalid processor multiplier for {name}: {mult}")
        if mult>0: active+=1
        if mult!=pinned_mult: drift.append({"name":name,"address":addr,"pinned_multiplier":pinned_mult,"live_multiplier":mult})
        trans=address_call(addr,SEL["transistors"]); mint_price=uint_call(trans,SEL["mintPrice"]); fee=uint_call(trans,SEL["protocolFee"]); cap=uint_call(trans,SEL["supplyCap"]); minted=uint_call(trans,SEL["minted"])
        if uint_call(trans,SEL["NAND"])!=0 or uint_call(trans,SEL["LATCH"])!=1: raise RuntimeError(f"unexpected transistor token IDs for {name}")
        rows.append({"name":name,"address":addr,"multiplier":mult,"pinned_multiplier":pinned_mult,"multiplier_changed":bool(mult!=pinned_mult),"active_for_mining":bool(mult>0),"transistors":trans,"mint_price_wei":mint_price,"protocol_fee_wei":fee,"supply_cap":cap,"minted":minted})
    if active<=0: raise RuntimeError("no audited processor currently participates in mining")
    return {"chain_id":cid,"block_number":block,"gas_price_wei":gas,"bnb_usd":float(bnb_usd),"source":f"official TapeOut v8.1 deployment discovery pins + live BNB mining state + {bnb_source}","verified_source":True,"processors":rows,"active_processor_count":active,"processor_multiplier_drift":drift}

def main():
    req=json.load(sys.stdin); action=req.get("action"); payload=req.get("payload") or {}
    if action=="chain_snapshot": print(json.dumps({"ok":True,"snapshot":chain_snapshot(payload)},separators=(",",":")))
    elif action=="chain_snapshots": print(json.dumps({"ok":True,"snapshots":chain_snapshots(payload)},separators=(",",":")))
    elif action=="probe": print(json.dumps({"ok":True,"probe":probe()},separators=(",",":")))
    else: raise RuntimeError("unsupported action")

if __name__=="__main__":
    try: main()
    except Exception as e: print(json.dumps({"ok":False,"error":f"{type(e).__name__}: {e}"}))
