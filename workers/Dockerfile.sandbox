FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

# Sandbox payloads need npm for the allowlisted test/build/lint tasks. Upgrade
# the bundled npm in-place so its node-tar dependency is >= 7.5.19 (CVE-2026-59873).
RUN npm install -g npm@10.9.9 \
 && node -e "const v=require('/usr/local/lib/node_modules/npm/node_modules/tar/package.json').version.split('.').map(Number); if(v[0]<7||(v[0]===7&&v[1]<5)||(v[0]===7&&v[1]===5&&v[2]<19)) process.exit(1)" \
 && apt-get update \
 && apt-get install -y --no-install-recommends bubblewrap git python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app
COPY sandbox-worker.mjs /app/sandbox-worker.mjs

# The trusted launcher runs as root so bubblewrap can create the isolated
# namespaces on hardened Linux hosts. User code is dropped to an unprivileged
# UID/GID with all capabilities removed inside bubblewrap before execution.
USER root
CMD ["node","/app/sandbox-worker.mjs"]
